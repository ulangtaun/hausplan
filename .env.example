# Kopieren nach .env und anpassen. Die Datei .env gehört NICHT ins Git-Repository.
SECRET_KEY=bitte-durch-langen-zufallswert-ersetzen   # python3 -c "import secrets; print(secrets.token_hex(32))"
# Sonderzeichen im Passwort URL-kodieren: @ -> %40, : -> %3A, / -> %2F, # -> %23
DATABASE_URL=postgresql+psycopg2://hausplan:PASSWORT@192.168.178.221/hausplan
# Hinter Cloudflare (HTTPS) -> Cookies nur über HTTPS
SESSION_COOKIE_SECURE=true
# Anzahl Reverse-Proxies vor Gunicorn (Nginx)
PROXY_COUNT=1
